<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Habilita tráfego cleartext HTTP globalmente para permitir reprodução de IPTV e servidores com redirecionamentos -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

